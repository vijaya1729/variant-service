# Supabase Postgres via the transaction pooler (port 6543), not the direct connection
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Sent as X-Admin-Key on admin endpoints, which all return 401 while this is empty. Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# How long each instance serves cached config before reloading it, so also the lag on a pause
CONFIG_TTL_SECONDS=30

# Anthropic API key for variant generation, used server-side only
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
